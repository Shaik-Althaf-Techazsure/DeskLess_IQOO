# Copy to .env to change any of these.
# On a developer's machine every value has a working default, so .env is optional there.
# On a real server the part headed "On a real server" has to be filled in.

# Ports published on this machine
APP_PORT=8700
SERVER_PORT=8800
MAIL_PORT=8825
WEB_PORT=8600
WEB_TLS_PORT=8643

# Database (only reachable inside the Docker network)
POSTGRES_USER=deskless
POSTGRES_PASSWORD=deskless
POSTGRES_DB=deskless

# ---- The server: accounts, reports, dashboards ----
# On a real server (docker compose -f docker-compose.server.yml up -d --build), fill in this part.
# Where people reach the server, with the path it sits under on the domain. The dashboards are then at
# <PUBLIC_URL>/dashboard and the app talks to <PUBLIC_URL>/api. Leave empty on a developer's machine.
#   PUBLIC_URL=https://shaikalthaf.in/competitions/IQOO
PUBLIC_URL=
# The administrator: signs in on the dashboard with this address and approves each company's managing director.
ADMIN_EMAIL=admin@deskless.local
# Leave these three empty on a developer's machine: they are generated on first start and kept in the
# "accounts" Docker volume (read the password with: docker compose exec server sh -c "cat /data/admin-password.txt").
# On a real server set all three, and keep a copy somewhere safe: losing SECRET_KEY signs everyone out,
# and losing AADHAAR_KEY makes the stored Aadhaar numbers unreadable for good.
#   ADMIN_PASSWORD:  one you choose
#   SECRET_KEY:      openssl rand -base64 48
#   AADHAAR_KEY:     openssl rand -base64 32
ADMIN_PASSWORD=
SECRET_KEY=
AADHAAR_KEY=

# Email: sign-up codes, approvals, work given out.
# On a developer's machine, unset, every email goes to the test mailbox at http://localhost:8825 and
# none reaches a real address. On a real server name a mail server here, or nobody receives their code
# (it is then only written to the server's log).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls      # none | starttls | ssl
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=DeskLess <no-reply@example.com>

# The company's clock against UTC, in minutes (330 is India). A deadline is overdue by that clock.
# UTC_OFFSET_MINUTES=330

# On a real server the server listens on this machine only, behind the site's web server.
# Set 0.0.0.0 only if that web server runs somewhere it cannot reach 127.0.0.1 from.
# SERVER_BIND=127.0.0.1

# ---- The Android app, as built by Docker ----
# The address the app is built to sign in and send reports to. It must be one a phone can reach:
# http://<this machine's IP>:8800 on the same Wi-Fi, or the server's public address.
# Left empty it is PUBLIC_URL; with that empty too, the app is built for an emulator on this machine.
# The address can also be changed on the app's first screen.
APP_SERVER_URL=

# ---- The web prototype ----
# Speech-to-text model baked into the backend image: tiny | base | small | medium
# Larger models transcribe mixed Hindi-English better but are slower and make the image bigger.
WHISPER_MODEL=small

# Local LLM, used only with:  docker compose --profile ai up --build
LLM_MODEL=gemma3:4b
# To use an Ollama server that already runs on this machine instead of the bundled one:
# OLLAMA_URL=http://host.docker.internal:11434
