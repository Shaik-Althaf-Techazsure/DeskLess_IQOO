# Copy to .env to change any of these. Every value has a working default, so .env is optional.

# Ports published on this machine
APP_PORT=8700
WEB_PORT=8600
WEB_TLS_PORT=8643

# Database (only reachable inside the Docker network)
POSTGRES_USER=deskless
POSTGRES_PASSWORD=deskless
POSTGRES_DB=deskless

# Speech-to-text model baked into the backend image: tiny | base | small | medium
# Larger models transcribe mixed Hindi-English better but are slower and make the image bigger.
WHISPER_MODEL=small

# Local LLM, used only with:  docker compose --profile ai up --build
LLM_MODEL=gemma3:4b
# To use an Ollama server that already runs on this machine instead of the bundled one:
# OLLAMA_URL=http://host.docker.internal:11434
